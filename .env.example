# ==============================================================================
# ApniYatra Environment Configuration (.env.example)
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# For Local Docker Compose / Local PostgreSQL:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_postgres_password
POSTGRES_DB=apniyatra_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_local_postgres_password@localhost:5432/apniyatra_db

# For Production Managed Database (e.g. Render, Supabase, Neon, Railway, AWS RDS):
# Note: Both postgresql:// and postgres:// connection prefixes are automatically supported.
# Example Supabase / Neon:
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/apniyatra_db?sslmode=require
# Example Render Internal/External:
# DATABASE_URL=postgresql://apniyatra_user:password@dpg-sample.oregon-postgres.render.com/apniyatra_db

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# Generate a strong 256-bit random key for JWT: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. Application Environment & Networking
# ------------------------------------------------------------------------------
ENVIRONMENT=development
BACKEND_PORT=8000
# JSON array or comma-separated list of allowed origins:
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://apniyatra.vercel.app"]

# ------------------------------------------------------------------------------
# 4. Optional AI Services (Google Gemini)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 5. Frontend API Configuration (for Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
