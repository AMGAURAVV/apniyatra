# ==============================================================================
# ApniYatra Backend Environment Configuration (.env.example)
# Copy this file to .env or backend/.env and fill in your actual values.
# NEVER commit your actual .env file or credentials to source control.
# ==============================================================================

# Database Configuration (PostgreSQL)
# Local: postgresql://postgres:postgres@localhost:5432/apniyatra_db
# Cloud (Render/Supabase/Neon): postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apniyatra_db

# Security
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Environment & Server
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional AI Features
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
